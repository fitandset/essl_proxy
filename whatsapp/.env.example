PORT=3000

# Supabase (service role — server only, never expose to browsers)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session row in public.whatsapp_baileys_sessions
SESSION_ID=default

# When behind nginx in Docker, set to /wa
# BASE_PATH=/wa

# Optional. When set, session routes require header x-api-key
ADMIN_API_KEY=

# warn = errors and warnings only. Use info if you need QR/send chatter.
LOG_LEVEL=warn

# baileys-antiban (peak enquiry days were ~28, so 30)
ANTIBAN_MAX_PER_DAY=30
ANTIBAN_MAX_PER_HOUR=8
ANTIBAN_MAX_PER_MINUTE=3
ANTIBAN_MIN_DELAY_MS=2500
ANTIBAN_MAX_DELAY_MS=7000
ANTIBAN_NEW_CHAT_DELAY_MS=4000
ANTIBAN_MAX_IDENTICAL=3
ANTIBAN_WARMUP_DAYS=30
